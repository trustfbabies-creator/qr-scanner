# Copy this to .env or add to Vercel Settings -> Environment Variables

# ₹999 Single Entry backend
TFB_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_999_DEPLOYMENT_ID/exec
TFB_API_SECRET=your_32_character_secret_for_999_backend

# ₹1699 Couple Entry backend
TFB_1699_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_1699_DEPLOYMENT_ID/exec
TFB_1699_API_SECRET=your_32_character_secret_for_1699_backend

# Shared
TFB_ALLOWED_ORIGIN=https://your-vercel-domain.vercel.app

